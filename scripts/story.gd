extends RefCounted
## Диалоги и сцены. Тексты-заготовки: их стоит переписать под канон мира.
## Узел: who, text, fx (при входе), choices[{t, next, if, check:[навык, сложность], ok, fail, fx, fail_fx}], route[[условие, узел]...].

const WHO := {
	"trader": {"name": "Бартоломей, старьёвщик", "faction": 0},
	"cook": {"name": "Матушка Грета", "faction": 2},
	"surgeon": {"name": "Ирвин Кост, хирург", "faction": 3},
	"emirra": {"name": "Эмирра", "faction": 5},
	"guard": {"name": "Страж ворот", "faction": 0},
	"old": {"name": "Слепой Ефим", "faction": 6},
	"raider": {"name": "Падальщик", "faction": 5},
}

const SHOPS := {
	"trader": ["Бинт", "Стимулятор", "Сухпаёк", "Успокоительное", "Пистолетные патроны",
		"Револьверные патроны", "Аккумулятор", "Нож", "Труба", "Куртка из шкур", "Горлорез"],
}


static func nodes() -> Dictionary:
	var n := {}

	n["intro"] = {"who": "", "text": "Гермошлюз за спиной закрывается с шипением. Пейджер Института пищит и выводит строку:\n\n«УЗЕЛ: КАЛЬДЕРА. ГЕНИЙ {callsign}, ВАШ СТАРТОВЫЙ КАПИТАЛ — 300 СУ. ИНСТИТУТ НЕ НЕСЁТ ОТВЕТСТВЕННОСТИ ЗА ВАШУ ЖИЗНЬ».\n\nКальдера — Подземка, выросшая в жерле давно уснувшего вулкана. Тепло дают камни, свет дают Сефиры, всё остальное приходится покупать.\n\n[color=#3fae47]Подсказка: мышь или WASD — ходить, клик или E — говорить и действовать, Tab — пейджер с листом Гения и сохранением.[/color]",
		"choices": [{"t": "Осмотреться.", "next": "end"}]}

	# ---------- Старьёвщик ----------
	n["trader_start"] = {"who": "trader", "text": "Бартоломей поправляет треснувшие очки и шевелит усами.\n\n— А, свежий Гений. Пахнешь стерильностью Института. Это ненадолго. Покупаешь или продаёшь?",
		"choices": [
			{"t": "Торговать.", "fx": [["shop", "trader"]], "next": "end"},
			{"t": "Что это за место — Кальдера?", "next": "trader_lore"},
			{"t": "Есть работа?", "next": "trader_work"},
			{"t": "Уйти.", "next": "end"}]}
	n["trader_lore"] = {"who": "trader", "text": "— Кальдера стоит на тёплом камне. Кроты её вырыли, МГС её посчитали, а живут тут все, кто не помер наверху. Ворота — на восток. За ними Пустошь, и она тебя не любит.",
		"choices": [{"t": "Ещё вопрос.", "next": "trader_start"}, {"t": "Уйти.", "next": "end"}]}
	n["trader_work"] = {"who": "trader", "text": "— Работа? Хирург ищет груз медикаментов, караван не дошёл. На доске Института висит заказ на псов. А я тут торгую, а не раздаю подвиги.",
		"choices": [{"t": "Ещё вопрос.", "next": "trader_start"}, {"t": "Уйти.", "next": "end"}]}

	# ---------- Столовая ----------
	n["cook_start"] = {"who": "cook", "text": "Матушка Грета мешает варево, от которого пахнет железом и луком.\n\n— Садись, голодный. Миска похлёбки — 15 Су. Ешь, пока горячо: наверху так не кормят.",
		"choices": [
			{"t": "Похлёбку, пожалуйста. (15 Су)", "if": "su>=15", "fx": [["su", -15], ["feed", 50], ["calm", 5]], "next": "cook_eat"},
			{"t": "А из чего она?", "next": "cook_what"},
			{"t": "Расскажите о Кальдере.", "next": "cook_lore"},
			{"t": "Уйти.", "next": "end"}]}
	n["cook_eat"] = {"who": "cook", "text": "Похлёбка обжигает горло. Внутри становится теплее, чем снаружи.\n\n[color=#7ff07a](+50 сытости, +5 ООР)[/color]",
		"choices": [{"t": "Спасибо.", "next": "end"}]}
	n["cook_what"] = {"who": "cook", "text": "— Из того, что приносят Гении. Не спрашивай, если хочешь есть дальше.",
		"choices": [
			{"t": "[Присмотреться к котлу]", "check": ["Понимание", 12], "ok": "cook_what_ok", "fail": "cook_what_fail"},
			{"t": "Не буду спрашивать.", "next": "cook_start"}]}
	n["cook_what_ok"] = {"who": "cook", "text": "Вы замечаете в углу шкуру с серой свалявшейся шерстью. Пустынный пёс. Грета ловит ваш взгляд и подмигивает.\n\n— Мясо есть мясо, милый. Принесёшь шкуру — старьёвщик даст за неё денег.",
		"choices": [{"t": "Учту.", "next": "cook_start"}]}
	n["cook_what_fail"] = {"who": "cook", "text": "Она улыбается так ласково, что вы решаете больше не уточнять.",
		"choices": [{"t": "Ладно.", "next": "cook_start"}]}
	n["cook_lore"] = {"who": "cook", "text": "— Здесь трудно радоваться, поэтому мы радуемся по расписанию. Каждый седьмой день — праздник. Приходи, если доживёшь.",
		"choices": [{"t": "Постараюсь.", "next": "cook_start"}]}

	# ---------- Хирург ----------
	n["surgeon_start"] = {"who": "surgeon", "text": "Хирург Ирвин Кост не поднимает глаз от инструментов. Маска на лице давно стала частью кожи.\n\n— Режем, шьём, вопросов не задаём. Чем болеем?",
		"choices": [
			{"t": "Залатайте меня. ({heal_cost} Су)", "if": "hurt", "fx": [["heal_full"]], "next": "surgeon_done"},
			{"t": "Обработайте раны. (40 Су)", "if": "wounds", "fx": [["su", -40], ["fix_wounds"]], "next": "surgeon_wounds"},
			{"t": "Избавьте от травмы. (120 Су)", "if": "injury", "fx": [["su", -120], ["remove_injury"]], "next": "surgeon_injury"},
			{"t": "Вам нужна помощь?", "if": "!quest:med", "next": "surgeon_quest"},
			{"t": "Вот ваш ящик медикаментов.", "if": "has:Ящик медикаментов", "fx": [["take", "Ящик медикаментов"], ["su", 150], ["quest", "med", "closed"], ["flag", "free_heal"]], "next": "surgeon_thanks"},
			{"t": "Уйти.", "next": "end"}]}
	n["surgeon_done"] = {"who": "surgeon", "text": "Игла входит в кожу без предупреждения. Через минуту вы снова похожи на человека.\n\n— Следующий.",
		"choices": [{"t": "Уйти.", "next": "end"}]}
	n["surgeon_wounds"] = {"who": "surgeon", "text": "Он промывает раны чем-то, что жжёт сильнее, чем сами раны, и накладывает швы ровными стежками.\n\n— Руки и ноги снова твои. Береги их, запасных у меня нет.",
		"choices": [{"t": "Уйти.", "next": "end"}]}
	n["surgeon_injury"] = {"who": "surgeon", "text": "{injury_result}",
		"choices": [{"t": "Уйти.", "next": "end"}]}
	n["surgeon_quest"] = {"who": "surgeon", "text": "— Караван из Тристаля вёз мне медикаменты. Не дошёл. Последний сигнал пейджера — юго-восток, за руинами.\n\nПринеси ящик с красным крестом, заплачу 150 Су. Если там остались тела — мне не нужно их видеть.",
		"choices": [
			{"t": "Возьмусь.", "fx": [["quest", "med", "active"], ["say", "Новая задача: найти ящик медикаментов на юго-востоке Пустоши."]], "next": "end"},
			{"t": "Подумаю.", "next": "end"}]}
	n["surgeon_thanks"] = {"who": "surgeon", "text": "Он вскрывает ящик и пересчитывает ампулы.\n\n— Целый. Даже не побились. Держи 150 Су. И ещё: следующее лечение за мой счёт.",
		"choices": [{"t": "Рад помочь.", "next": "end"}]}

	# ---------- Эмирра ----------
	var em_choices := [
		{"t": "Кто ты?", "if": "!flag:emirra_named", "fx": [["flag", "emirra_named"]], "next": "emirra_who"},
		{"t": "Верни монеты, рыжая.", "if": "flag:emirra_noticed", "next": "emirra_caught"},
		{"t": "Знаешь что-нибудь о караване?", "if": "quest:med=active", "fx": [["flag", "emirra_tip"]], "next": "emirra_caravan"},
		{"t": "[Предложить выпить]", "if": "!flag:emirra_friend", "check": ["Дружелюбие", 12], "ok": "emirra_friend", "fail": "emirra_cold"},
		{"t": "Мне пора.", "next": "end"}]
	n["emirra_start"] = {"route": [["flag:emirra_met", "emirra_menu"], ["emirra_first"]]}
	n["emirra_first"] = {"who": "emirra", "fx": [["flag", "emirra_met"], ["emirra_steal"]],
		"text": "Рыжая девушка сидит на бочке и подбрасывает монетку. Золотой зуб блестит в свете ламп. Она спрыгивает, задевает вас плечом и улыбается.\n\n— Новенький? Пейджер ещё пищит, как щенок. Что ищешь, Гений?",
		"choices": em_choices}
	n["emirra_menu"] = {"who": "emirra", "text": "Эмирра подбрасывает монетку и ловит её, не глядя.\n\n— Опять ты. Соскучился?", "choices": em_choices}
	n["emirra_who"] = {"who": "emirra", "text": "— Эмирра. Золотые Клыки, если тебе это о чём-то говорит. А если не говорит — тем лучше для тебя.\n\nЯ ищу кое-что, что потеряла. Или кое-кого.",
		"choices": em_choices}
	n["emirra_caught"] = {"who": "emirra", "fx": [["su", 25], ["flag", "emirra_noticed", false], ["flag", "emirra_respect"]],
		"text": "Она смеётся и бросает вам ваши же 25 Су.\n\n— Глазастый. Ладно, это был тест. Ты прошёл. Почти.", "choices": em_choices}
	n["emirra_caravan"] = {"who": "emirra", "text": "— Караван? Видела дым на юго-востоке, у разбитых фургонов. Только не ходи туда с пустыми руками: там бродит что-то, что раньше было человеком.\n\nСтреляй в глаза. Если они у него ещё есть.",
		"choices": em_choices}
	n["emirra_friend"] = {"who": "emirra", "fx": [["item", "Отмычка"], ["flag", "emirra_friend"]],
		"text": "Она прищуривается, потом кивает.\n\n— Ладно, Гений. Ты первый, кто смотрит на меня не как на добычу. Держи. Пригодится, если найдёшь закрытый ящик у падальщиков.\n\n[color=#7ff07a](Получено: Отмычка)[/color]", "choices": em_choices}
	n["emirra_cold"] = {"who": "emirra", "text": "— Я не пью с теми, у кого пейджер пищит громче, чем сердце. Отвали.",
		"choices": [{"t": "Уйти.", "next": "end"}]}

	# ---------- Страж и старик ----------
	n["guard_start"] = {"who": "guard", "text": "Страж в шлеме с красной полосой перегораживает проход.\n\n— Выход в Пустошь. Наружу оружие носить можно, внутрь — только в кобуре. Вернёшься — постучи трижды. Не вернёшься — мы поймём.",
		"choices": [{"t": "Что там, снаружи?", "next": "guard_out"}, {"t": "Понял.", "next": "end"}]}
	n["guard_out"] = {"who": "guard", "text": "— Псы, падальщики и то, о чём не говорят при детях. Псы трусливы: перебей им лапы, и они сбегут, а ты успеешь уйти.\n\nА если увидишь человека, который улыбается слишком широко, — беги.",
		"choices": [{"t": "Спасибо.", "next": "end"}]}
	n["old_start"] = {"who": "old", "text": "Старик с белыми глазами сидит на ящике и поворачивает голову на звук ваших шагов.\n\n— Новые шаги. Лёгкие ещё. Садись, Гений. Слепой Ефим видит больше зрячих.",
		"choices": [
			{"t": "[Расспросить о Запутанности]", "check": ["История", 11], "ok": "old_lore", "fail": "old_ramble"},
			{"t": "[Помолиться вместе с ним]", "if": "!flag:prayed", "fx": [["flag", "prayed"]], "check": ["Молитва", 12], "ok": "old_pray_ok", "fail": "old_pray_fail"},
			{"t": "Уйти.", "next": "end"}]}
	n["old_lore"] = {"who": "old", "text": "— В Золотой век люди нашли Сефиры и Когито, психическую плоть богов, и сделали из неё лампочки и импланты. Построили Контур Артифика, бога из проводов. А культисты захотели родить своего.\n\nБоги не любят, когда их делают на заказ. Так пришла Запутанность, и законы мира стали рекомендациями.",
		"choices": [{"t": "Спасибо, Ефим.", "next": "old_start"}]}
	n["old_ramble"] = {"who": "old", "text": "Старик долго говорит о каком-то Арбитре, о весах и о том, что «Чезед всё помнит». Вы теряете нить на третьей минуте.",
		"choices": [{"t": "Ясно...", "next": "old_start"}]}
	n["old_pray_ok"] = {"who": "old", "fx": [["calm", 15]], "text": "Вы повторяете за стариком слова, которых не понимаете. На секунду лампы светят ровнее, и шёпот в голове затихает.\n\n[color=#7ff07a](+15 ООР)[/color]",
		"choices": [{"t": "...", "next": "old_start"}]}
	n["old_pray_fail"] = {"who": "old", "fx": [["mind", -6]], "text": "Вы молитесь, и кто-то отвечает. Не Ефим. Голос звучит изнутри черепа, и он смеётся.\n\n[color=#ff6650](-6 ООР)[/color]",
		"choices": [{"t": "...", "next": "old_start"}]}

	# ---------- Предметы Кальдеры ----------
	n["terminal"] = {"who": "", "text": "ТЕРМИНАЛ ИНСТИТУТА ПО ЭТИКЕ\n\nГений: {callsign}\nСтатус: АКТИВЕН\nФракция: {faction}\n\nНапоминание: Ваша безопасность — наш приоритет. Ваша жизнь — Ваша ответственность.",
		"choices": [
			{"t": "Справка: кто такие Гении", "next": "terminal_genii"},
			{"t": "Справка: Пустошь", "next": "terminal_waste"},
			{"t": "Выйти", "next": "end"}]}
	n["terminal_genii"] = {"who": "", "text": "Гении — курьеры, разведчики и добытчики, которые ходят между Подземками. Институт по Этике выдаёт им пейджеры, регистрирует их личные карты и платит в Су.\n\nСмертность Гениев в первый год — 61%. Институт благодарит Вас за вклад в статистику.",
		"choices": [{"t": "Назад", "next": "terminal"}]}
	n["terminal_waste"] = {"who": "", "text": "Пустошь — поверхность после Запутанности. Законы физики там носят рекомендательный характер.\n\nРекомендации Института: следите за сытостью, носите бинты, не смотрите в глаза тому, что улыбается.",
		"choices": [{"t": "Назад", "next": "terminal"}]}
	n["board"] = {"route": [["quest:dogs=done", "board_done"], ["quest:dogs=active", "board_active"], ["quest:dogs=closed", "board_empty"], ["board_new"]]}
	n["board_new"] = {"who": "", "text": "ДОСКА ЗАДАНИЙ ИНСТИТУТА\n\nЗАКАЗ №117. Отстрел пустынных псов у ворот Кальдеры. Требуется: 3 особи.\nОплата: 90 Су по факту.",
		"choices": [{"t": "Принять заказ", "fx": [["accept_dogs"]], "next": "end"}, {"t": "Отойти", "next": "end"}]}
	n["board_active"] = {"who": "", "text": "ЗАКАЗ №117 в работе. Убито псов: {dogs} из 3.", "choices": [{"t": "Отойти", "next": "end"}]}
	n["board_done"] = {"who": "", "text": "ЗАКАЗ №117 выполнен. Пейджер подтверждает три убийства.",
		"choices": [{"t": "Получить 90 Су", "fx": [["su", 90], ["quest", "dogs", "closed"], ["say", "Институт перевёл 90 Су."]], "next": "end"}]}
	n["board_empty"] = {"who": "", "text": "Новых заказов пока нет. Институт благодарит за сотрудничество.", "choices": [{"t": "Отойти", "next": "end"}]}
	n["bed"] = {"who": "", "text": "Койка в ночлежке. Пахнет чужим потом и машинным маслом. Ночь стоит 20 Су.",
		"choices": [{"t": "Спать (20 Су)", "if": "su>=20", "fx": [["sleep"]], "next": "bed_slept"}, {"t": "Уйти", "next": "end"}]}
	n["bed_slept"] = {"who": "", "text": "Вам снится, что Сефиры смотрят на вас сквозь потолок. Утром в голове чуть тише.\n\n[color=#7ff07a](+30 ООЗ, +30 ООР, Воля восстановлена, -10 сытости)[/color]",
		"choices": [{"t": "Встать", "next": "end"}]}
	n["gate_out"] = {"who": "", "text": "Гермоворота Кальдеры. Страж кладёт руку на рычаг и ждёт. Пейджер открывает карту поверхности.",
		"choices": [{"t": "Выйти на карту мира", "fx": [["at", "caldera"], ["goto", "map", ""]], "next": "end"}, {"t": "Остаться", "next": "end"}]}

	# ---------- Пустошь ----------
	n["gate_in"] = {"who": "", "text": "Дорога к воротам Кальдеры. Отсюда можно уйти на карту поверхности.",
		"choices": [{"t": "Выйти на карту мира", "fx": [["at", "outskirts"], ["goto", "map", ""]], "next": "end"}, {"t": "Остаться", "next": "end"}]}
	n["cache_med"] = {"route": [["flag:med_taken", "cache_med_empty"], ["cache_med_full"]]}
	n["cache_med_full"] = {"who": "", "text": "Ящик с облезлым красным крестом придавлен колесом фургона. Рядом лежит то, что осталось от погонщика. Внутри — запечатанные ампулы и бинты.",
		"choices": [{"t": "Забрать", "fx": [["item", "Ящик медикаментов"], ["item", "Бинт", 2], ["flag", "med_taken"], ["say", "Получено: Ящик медикаментов, Бинт ×2."]], "next": "end"}, {"t": "Не трогать", "next": "end"}]}
	n["cache_med_empty"] = {"who": "", "text": "Пустой ящик. Ветер гоняет внутри песок.", "choices": [{"t": "Отойти", "next": "end"}]}
	n["cache_ruin"] = {"route": [["flag:ruin_open", "cache_ruin_empty"], ["cache_ruin_locked"]]}
	n["cache_ruin_locked"] = {"who": "", "text": "Железный ящик, вмурованный в пол руин. На крышке нацарапан клык. Замок новый и злой.",
		"choices": [
			{"t": "Открыть отмычкой Эмирры", "if": "has:Отмычка", "next": "cache_ruin_open"},
			{"t": "[Вскрыть замок]", "check": ["Механика", 14], "ok": "cache_ruin_open", "fail": "cache_ruin_fail", "fail_fx": [["hurt", 4]]},
			{"t": "[Сбить замок]", "check": ["Атлетика", 16], "ok": "cache_ruin_open", "fail": "cache_ruin_fail", "fail_fx": [["hurt", 6]]},
			{"t": "Уйти", "next": "end"}]}
