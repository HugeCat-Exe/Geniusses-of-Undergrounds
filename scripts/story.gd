static func nodes() -> Dictionary:
	var n := {}

	n["intro"] = {"who": "", "text": "Люк над головой захлопывается, и ржавая лестница выводит вас на первый ярус. Пейджер Института пищит и выводит строку:\n\n«УЗЕЛ: КАЛЬДЕРА. ГЕНИЙ {callsign}, ВАШ СТАРТОВЫЙ КАПИТАЛ — 300 СУ. ИНСТИТУТ НЕ НЕСЁТ ОТВЕТСТВЕННОСТИ ЗА ВАШУ ЖИЗНЬ».\n\nКальдера — Подземка, выросшая в жерле давно уснувшего вулкана и уходящая вниз ярусами. Тепло дают камни, свет дают Сефиры, всё остальное приходится покупать.\n\nЯрус 1 — вход и пост стражи. Ярус 2 — хирург, оружейник, лавка и доска объявлений. Ярус 3 — мотель, кухня и бар. Ярус 4 — жилые кварталы. Между ярусами — лестницы и грузовой лифт.\n\n[color=#3fae47]Подсказка: мышь или WASD — ходить, клик или E — говорить и действовать, Tab — пейджер с листом Гения и сохранением.[/color]",
		"choices": [{"t": "Осмотреться.", "next": "end"}]}

	# ---------- Старьёвщик ----------
	n["trader_start"] = {"who": "trader", "hub": true, "text": "Бартоломей поправляет треснувшие очки и шевелит усами. Вокруг висят куртки, жилеты, плащи и бусы из гаек.\n\n— А, свежий Гений. Пахнешь стерильностью Института. Это ненадолго. Одежда, побрякушки, всякая всячина. Покупаешь или продаёшь?",
		"choices": [
			{"t": "Торговать.", "fx": [["shop", "trader"]], "next": "end"},
			{"t": "Что это за место — Кальдера?", "next": "trader_lore"},
			{"t": "Есть работа?", "next": "trader_work"},
			{"t": "Слышал про Собачьего Муэдзина?", "next": "trader_mu"},
			{"t": "Уйти.", "next": "end"}]}
	n["trader_lore"] = {"who": "trader", "text": "— Кальдера стоит на тёплом камне. Кроты её вырыли, МГС её посчитали, а живут тут все, кто не помер наверху. Чем ниже ярус, тем теплее и тем дороже жильё. Выход — наверх, по шахте с первого яруса. Там Пустошь, и она тебя не любит.",
		"choices": [{"t": "Ещё вопрос.", "next": "trader_start"}, {"t": "Уйти.", "next": "end"}]}
	n["trader_work"] = {"who": "trader", "text": "— Работа? Хирург ищет груз медикаментов, караван не дошёл. На доске объявлений тут же, на ярусе, каждый день новые заказы: псы, падальщики, всякие поиски. А я тут торгую, а не раздаю подвиги.",
		"choices": [{"t": "Ещё вопрос.", "next": "trader_start"}, {"t": "Уйти.", "next": "end"}]}

	# ---------- Столовая ----------
	n["cook_start"] = {"who": "cook", "hub": true, "fx": [["flag", "cook_met"]], "text": "Матушка Грета мешает варево, от которого пахнет железом и луком.\n\n— Садись, голодный. Миска похлёбки — 15 Су. Ешь, пока горячо: наверху так не кормят.",
		"choices": [
			{"t": "Похлёбку, пожалуйста. (15 Су)", "if": "su>=15", "fx": [["su", -15], ["feed", 50], ["calm", 5]], "next": "cook_eat"},
			{"t": "Наваристую похлёбку. (40 Су)", "if": "flag:spice_done", "next": "cook_rich"},
			{"t": "Помочь на кухне.", "if": "!today:cook_help_day", "next": "cook_help"},
			{"t": "Вам что-то нужно, Матушка?", "if": "spice_ready", "next": "spice_offer"},
			{"t": "Я принёс все три травы.", "if": "spice_all", "next": "spice_done"},
			{"t": "А из чего она?", "next": "cook_what"},
			{"t": "Расскажите о Кальдере.", "next": "cook_lore"},
			{"t": "Уйти.", "next": "end"}]}
	n["cook_rich"] = {"route": [["su>=40", "cook_rich_ok"], ["cook_rich_no"]]}
	n["cook_rich_ok"] = {"who": "cook", "fx": [["su", -40], ["item", "Наваристая похлёбка"]], "text": "Грета наливает похлёбку в жестяной котелок и закрывает крышкой.\n\n— С собой бери. На специях, как ты принёс. Такую и мёртвый съест, и встанет.\n\n[color=#7ff07a](Получено: Наваристая похлёбка — +60 сытости, +15 ООЗ)[/color]",
		"choices": [{"t": "Спасибо.", "next": "cook_start"}]}
	n["cook_rich_no"] = {"who": "cook", "text": "— Сорок Су, золотой. Специи сами себя не собирают.", "choices": [{"t": "Понял.", "next": "cook_start"}]}
	n["cook_help"] = {"who": "cook", "text": "— Помочь? Ну давай. Я буду называть, что кидать в котёл, а ты запоминай и кидай по порядку. Перепутаешь — будем есть то, что вышло.\n\n[color=#3fae47]Мини-игра «Рецепт»: запомните порядок продуктов и повторите его. Раз в день.[/color]",
		"choices": [{"t": "Начинаем.", "fx": [["day_flag", "cook_help_day"], ["minigame", "recipe"]], "next": "end"}, {"t": "В другой раз.", "next": "cook_start"}]}
	n["spice_offer"] = {"who": "cook", "text": "Грета пробует варево и морщится.\n\n— Соли хватает, а вкуса нет. Раньше был у меня перец, тимьян, мята... Всё кончилось.\n\nПринеси три травы, золотой. Пепельный тимьян растёт прямо у нашей шахты, в пепле. Собачья мята — только там, где спят псы, в их логове. А звёздный перец — в Запутанном лесу, на северо-востоке, рядом с цветами, которые кусаются.\n\nПринесёшь — заплачу и сварю такое, что будешь ходить сюда только за ним.",
		"choices": [{"t": "Соберу.", "fx": [["quest", "spice", "active"], ["mark", "forest"], ["mark", "den"], ["say", "Новая задача: Запутанные специи."]], "next": "end"}, {"t": "Не сейчас.", "next": "cook_start"}]}
	n["spice_done"] = {"who": "cook", "fx": [["take", "Пепельный тимьян"], ["take", "Собачья мята"], ["take", "Звёздный перец"], ["su", 80], ["rel", "cook", 10], ["quest", "spice", "closed"], ["flag", "spice_done"]],
		"text": "Грета нюхает каждую траву по очереди и улыбается так, что морщины расходятся.\n\n— Вот это запах! Держи 80 Су. И приходи завтра: будет наваристая похлёбка. Дороже, зато сытнее и раны затягивает.\n\n[color=#7ff07a](+80 Су. Теперь у Греты продаётся наваристая похлёбка.)[/color]",
		"choices": [{"t": "Приду.", "next": "cook_start"}]}
	n["cook_help_win"] = {"who": "cook", "text": "Грета пробует, причмокивает и кладёт вам в ладонь монеты.\n\n— Руки у тебя правильные. Не то что у моего покойного.\n\n[color=#7ff07a](+25 Су, тарелка похлёбки)[/color]", "choices": [{"t": "Обращайтесь.", "next": "end"}]}
	n["cook_help_part"] = {"who": "cook", "text": "Грета пробует и задумчиво жуёт.\n\n— Съедобно. Почти. Держи за старание.\n\n[color=#7ff07a](+10 Су)[/color]", "choices": [{"t": "Я научусь.", "next": "end"}]}
	n["cook_help_fail"] = {"who": "cook", "text": "Из котла поднимается чёрный дым. Грета молча берёт половник и выгоняет вас из кухни.\n\n— Завтра. Завтра попробуешь ещё раз.", "choices": [{"t": "Простите...", "next": "end"}]}
	n["cook_eat"] = {"who": "cook", "text": "Похлёбка обжигает горло. Внутри становится теплее, чем снаружи.\n\n[color=#7ff07a](+50 сытости, +5 ООР)[/color]",
		"choices": [{"t": "Спасибо.", "next": "end"}]}
	n["cook_what"] = {"who": "cook", "text": "— Из того, что приносят Гении. Не спрашивай, если хочешь есть дальше.",
		"choices": [
			{"t": "[Присмотреться к котлу]", "check": ["Понимание", 12], "ok": "cook_what_ok", "fail": "cook_what_fail"},
			{"t": "Не буду спрашивать.", "next": "cook_start"}]}
	n["cook_what_ok"] = {"who": "cook", "text": "Вы замечаете в углу шкуру с серой свалявшейся шерстью. Пустынный пёс. Грета ловит ваш взгляд и подмигивает.\n\n— Мясо есть мясо, милый. Принесёшь шкуру — старьёвщик даст за неё денег.",
		"choices": [{"t": "Учту.", "next": "cook_start"}]}
	n["cook_what_fail"] = {"who": "cook", "text": "Она улыбается так ласково, что вы решаете больше не уточнять.",
		"choices": [{"t": "Ладно.", "next": "cook_start"}]}
	n["cook_lore"] = {"who": "cook", "text": "— Здесь трудно радоваться, поэтому мы радуемся по расписанию. Каждый седьмой день — праздник. Приходи, если доживёшь.",
		"choices": [{"t": "Постараюсь.", "next": "cook_start"}]}

	# ---------- Хирург ----------
	n["surgeon_start"] = {"who": "surgeon", "hub": true, "text": "Хирург Ирвин Кост не поднимает глаз от инструментов. Маска на лице давно стала частью кожи.\n\n— Режем, шьём, вопросов не задаём. Если денег мало — вон автодок в углу, он дешевле и хуже. Чем болеем?",
		"choices": [
			{"t": "Купить лекарства.", "fx": [["shop", "medic"]], "next": "end"},
			{"t": "Залатайте меня. ({heal_cost} Су)", "if": "hurt", "fx": [["heal_full"]], "next": "surgeon_done"},
			{"t": "Обработайте раны. (40 Су)", "if": "wounds", "fx": [["su", -40], ["fix_wounds"]], "next": "surgeon_wounds"},
			{"t": "Избавьте от травмы. (120 Су)", "if": "injury", "fx": [["su", -120], ["remove_injury"]], "next": "surgeon_injury"},
			{"t": "Вам нужна помощь?", "if": "!quest:med", "next": "surgeon_quest"},
			{"t": "Вот ваш ящик медикаментов.", "if": "has:Ящик медикаментов", "fx": [["take", "Ящик медикаментов"], ["su", 150], ["quest", "med", "closed"], ["flag", "free_heal"], ["rel", "surgeon", 12]], "next": "surgeon_thanks"},
			{"t": "Уйти.", "next": "end"}]}
	n["surgeon_done"] = {"who": "surgeon", "text": "Игла входит в кожу без предупреждения. Через минуту вы снова похожи на человека.\n\n— Следующий.",
		"choices": [{"t": "Уйти.", "next": "end"}]}
	n["surgeon_wounds"] = {"who": "surgeon", "text": "Он промывает раны чем-то, что жжёт сильнее, чем сами раны, и накладывает швы ровными стежками.\n\n— Руки и ноги снова твои. Береги их, запасных у меня нет.",
		"choices": [{"t": "Уйти.", "next": "end"}]}
	n["surgeon_injury"] = {"who": "surgeon", "text": "{injury_result}",
		"choices": [{"t": "Уйти.", "next": "end"}]}
	n["surgeon_quest"] = {"who": "surgeon", "text": "— Караван из Тристаля вёз мне медикаменты. Не дошёл. Последний сигнал пейджера — юго-восток, за руинами.\n\nПринеси ящик с красным крестом, заплачу 150 Су. Если там остались тела — мне не нужно их видеть.",
		"choices": [
			{"t": "Возьмусь.", "fx": [["quest", "med", "active"], ["say", "Новая задача: найти ящик медикаментов на юго-востоке Пустоши."]], "next": "end"},
			{"t": "Подумаю.", "next": "end"}]}
	n["surgeon_thanks"] = {"who": "surgeon", "text": "Он вскрывает ящик и пересчитывает ампулы.\n\n— Целый. Даже не побились. Держи 150 Су. И ещё: следующее лечение за мой счёт.",
		"choices": [{"t": "Рад помочь.", "next": "end"}]}

	# ---------- Рыжая (бар «Клык», ярус 3) ----------
	var ry_choices := [
		{"t": "Кто ты?", "if": "!flag:ry_named", "fx": [["flag", "ry_named"]], "next": "ry_who"},
		{"t": "Верни монеты, рыжая.", "if": "flag:ry_noticed", "next": "ry_caught"},
		{"t": "Знаешь что-нибудь о караване?", "if": "quest:med=active", "fx": [["flag", "ry_tip"]], "next": "ry_caravan"},
		{"t": "[Предложить выпить]", "if": "!flag:ry_friend", "check": ["Дружелюбие", 12], "ok": "ry_friend", "fail": "ry_cold"},
		{"t": "Тебе нужна помощь?", "if": "errands=0", "next": "ry_job0"},
		{"t": "Есть ещё дело?", "if": "errands=1", "next": "ry_job1"},
		{"t": "Ты чем-то расстроена?", "if": "ry_earring_day", "next": "ry_earring"},
		{"t": "Ты хотела поговорить?", "if": "ry_test_ready", "next": "ry_test_1"},
		{"t": "Пойдёшь со мной в Пустошь?", "if": "flag:ry_test_done", "next": "ry_join"},
		{"t": "Уютно у тебя.", "if": "ry_home_chat", "fx": [["flag", "ry_home_chat"], ["rel", "ryzhaya", 2]], "next": "ry_home_talk"},
		{"t": "Мне пора.", "next": "end"}]
	n["ry_start"] = {"route": [["companion", "ry_comp"], ["flag:ry_met", "ry_menu"], ["ry_first"]]}
	n["ry_first"] = {"who": "ryzhaya", "hub": true, "fx": [["flag", "ry_met"], ["ry_steal"]],
		"text": "Рыжая девушка сидит у стойки «Клыка» и подбрасывает монетку. Золотой зуб блестит в неоне. Она соскальзывает с табурета, задевает вас плечом и улыбается.\n\n— Новенький? Пейджер ещё пищит, как щенок. Что ищешь, Гений?",
		"choices": ry_choices}
	n["ry_menu"] = {"who": "ryzhaya", "hub": true, "text": "Рыжая подбрасывает монетку и ловит её, не глядя.\n\n— Опять ты. Соскучился?", "choices": ry_choices}
	n["ry_who"] = {"who": "ryzhaya", "hub": true, "text": "— Зови меня Рыжей. Все зовут. Золотые Клыки, если тебе это о чём-то говорит. А если не говорит — тем лучше для тебя.\n\nЯ ищу кое-что, что потеряла. Или кое-кого.",
		"choices": ry_choices}
	n["ry_caught"] = {"who": "ryzhaya", "hub": true, "fx": [["su", 25], ["flag", "ry_noticed", false], ["flag", "ry_respect"], ["rel", "ryzhaya", 3]],
		"text": "Она смеётся и бросает вам ваши же 25 Су.\n\n— Глазастый. Ладно, это был тест. Ты прошёл. Почти.", "choices": ry_choices}
	n["ry_caravan"] = {"who": "ryzhaya", "hub": true, "text": "— Караван? Видела дым на юго-востоке, у разбитых фургонов. Только не ходи туда с пустыми руками: там бродит что-то, что раньше было человеком.\n\nСтреляй в глаза. Если они у него ещё есть.",
		"choices": ry_choices}
	n["ry_friend"] = {"who": "ryzhaya", "hub": true, "fx": [["item", "Отмычка"], ["flag", "ry_friend"], ["rel", "ryzhaya", 5]],
		"text": "Она прищуривается, потом кивает Гарри, и тот ставит два стакана.\n\n— Ладно, Гений. Ты первый, кто смотрит на меня не как на добычу. Держи. Пригодится, если найдёшь закрытый ящик у падальщиков.\n\n[color=#7ff07a](Получено: Отмычка)[/color]", "choices": ry_choices}
	n["ry_cold"] = {"who": "ryzhaya", "fx": [["rel", "ryzhaya", -2]], "text": "— Я не пью с теми, у кого пейджер пищит громче, чем сердце. Отвали.",
		"choices": [{"t": "Уйти.", "next": "end"}]}
	n["ry_job0"] = {"route": [["ry_job_active", "ry_busy"], ["ry_job0_offer"]]}
	n["ry_job0_offer"] = {"who": "ryzhaya", "text": "— Помощь? Ну... У обрывка дороги, где останавливаются караваны, развелись псы. Воют всю ночь, а звук идёт прямо по шахте ко мне в комнату. Разгонишь парочку — с меня 30 Су и благодарность.",
		"choices": [{"t": "Сделаю.", "fx": [["ry_job", "0"]], "next": "end"}, {"t": "Не сейчас.", "next": "ry_menu"}]}
	n["ry_job1"] = {"route": [["ry_job_active", "ry_busy"], ["ry_job1_offer"]]}
	n["ry_job1_offer"] = {"who": "ryzhaya", "text": "— Есть один падальщик, Шнырь. Взял у меня в долг и решил, что Пустошь большая. Пустошь маленькая, Гений. Найди его и объясни это. Можно без слов.",
		"choices": [{"t": "Объясню.", "fx": [["ry_job", "1"]], "next": "end"}, {"t": "Не сейчас.", "next": "ry_menu"}]}
