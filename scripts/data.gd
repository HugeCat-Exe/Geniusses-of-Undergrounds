func _init() -> void:
	ITEMS = BASE_ITEMS.duplicate(true)
	ITEMS.merge(Weapons.LIST, true)
	for bk in BOOKS:
		ITEMS[bk] = {"type": "book", "desc": "", "price": BOOKS[bk].price}
	for g in GIFTS:
		ITEMS[g] = {"type": "gift", "desc": "Подарок. " + GIFTS[g].desc, "price": GIFTS[g].price}


## Полное описание предмета: для оружия – строка характеристик и текст из хранилища.
func item_desc(it: String) -> String:
	if BOOKS.has(it):
		var bk: Dictionary = BOOKS[it]
		return "Книга Института: «%s». Прочитать – %s +2 на сутки. Читается один раз." % [bk.full, bk.get("stat", bk.get("skill", ""))]
	var info: Dictionary = ITEMS.get(it, {})
	if info.has("stats"):
		return "%s\n%s" % [info.stats, info.desc]
	return info.get("desc", "")
