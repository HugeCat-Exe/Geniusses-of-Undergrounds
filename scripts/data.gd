## Словесная оценка значения характеристики (шкала Б+В).
func grade(v: float) -> String:
	if v <= 1: return "ужасно"
	if v <= 3: return "ничтожно"
	if v <= 5: return "очень низкий"
	if v <= 7: return "низкий"
	if v <= 9: return "слабый"
	if v <= 11: return "средний"
	if v <= 13: return "выше среднего"
	if v <= 15: return "сильный"
	if v <= 17: return "очень сильный"
	if v <= 19: return "невероятный"
	if v <= 23: return "божественный"
	return "идеальный"


## Модификатор броска к20: (стат − 10) / 2 с округлением вниз.
func check_mod(v: float) -> int:
	return floori((v - 10.0) / 2.0)


