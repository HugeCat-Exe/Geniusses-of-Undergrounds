## Словесная оценка значения характеристики (шкала из «Показателей персонажа»).
func grade(v: float) -> String:
	if v <= -8: return "ужасно"
	if v <= -5: return "ничтожно"
	if v <= 1: return "очень низко"
	if v <= 7: return "низко"
	if v <= 10: return "слабо"
	if v <= 19: return "средне"
	if v <= 25: return "сильно"
	if v <= 28: return "очень сильно"
	if v <= 31: return "невероятно"
	if v <= 37: return "божественно"
	if v <= 40: return "идеально"
	return "максимум"


## Бонус к броску к20 от значения характеристики.
func check_mod(v: float) -> int:
	return clampi(floori((v - 14.0) / 3.0), -9, 9)


func skill_stat(skill: String) -> String:
	for s in SKILLS:
		if s[0] == skill:
			return s[1]
	return "УДЧ"


