func _init() -> void:
	ITEMS = BASE_ITEMS.duplicate(true)
	ITEMS.merge(Weapons.LIST, true)


## Полное описание предмета: для оружия — строка характеристик и текст из хранилища.
func item_desc(it: String) -> String:
	var info: Dictionary = ITEMS.get(it, {})
	if info.has("stats"):
		return "%s\n%s" % [info.stats, info.desc]
	return info.get("desc", "")
