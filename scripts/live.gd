## Замечание черты, раз в день на собеседника и не всегда.
static func pick_remark(who: String) -> Dictionary:
	if int(G.p.flags.get("rm_" + who, 0)) == int(G.p.day):
		return {}
	var pool: Array = []
	for tr in traits():
		if REMARKS.has(tr + "|" + who):
			pool.append([tr, REMARKS[tr + "|" + who]])
			pool.append([tr, REMARKS[tr + "|" + who]])
		elif REMARKS.has(tr):
			pool.append([tr, REMARKS[tr]])
	if pool.is_empty() or randf() > 0.45:
		return {}
	G.p.flags["rm_" + who] = int(G.p.day)
	var pk: Array = pool.pick_random()
	return {"trait": pk[0], "line": gender((pk[1] as Array).pick_random(), who)}


## Пороги рассудка – доля от максимума ООР: чем ниже, тем страннее мир. Ступень 0 – всё в порядке.
const MIND_STEPS := [0.6, 0.45, 0.33, 0.22, 0.12]
const MIND_LINES := [
	["Где-то капает вода. Вы ловите себя на том, что считаете капли.",
		"Лампа гудит на одной ноте. Уже минуту. Или час.",
