const BUCKET_NAMES := ["очень плохо", "плохо", "ничего", "хорошо", "очень хорошо"]


## Род собеседника и Гения в репликах: {он}, {его}, {ему}, {него}, {нём}, {ним}, окончания {а}, {ся}, {pa}.
static func gender(txt: String, who: String) -> String:
	var fem: bool = preload("res://scripts/story.gd").WHO.get(who, {}).get("fem", false)
	var pairs := {"{Он}": ["Он", "Она"], "{он}": ["он", "она"], "{Его}": ["Его", "Её"], "{его}": ["его", "её"],
		"{Ему}": ["Ему", "Ей"], "{ему}": ["ему", "ей"], "{него}": ["него", "неё"], "{нём}": ["нём", "ней"],
		"{ним}": ["ним", "ней"], "{а}": ["", "а"], "{ся}": ["ся", "ась"], "{сам}": ["сам", "сама"],
		"{прав}": ["прав", "права"], "{твой}": ["твой", "твоя"]}
	for k in pairs:
		txt = txt.replace(k, pairs[k][1 if fem else 0])
	return txt.replace("{pa}", "а" if G.p.get("sex", "М") == "Ж" else "")


static func traits() -> Array:
	return G.p.phys + G.p.got_phys + G.p.psy + G.p.got_psy


static func has(tr: String) -> bool:
	return tr in traits()


## Как часто черты вмешиваются: при полном ООР в каждой третьей сцене, ниже половины почти всегда.
static func voice_chance() -> float:
	var f := clampf(float(G.p.mind) / maxf(1.0, G.max_mind()), 0.0, 1.0)
	var c := 0.85 if f <= 0.5 else lerpf(0.85, 0.33, (f - 0.5) / 0.5)
	if has("Безынтересность"):
		c *= 0.5
	return c


## Рассудок сдвигает бросок: −2 за каждую потерянную четверть ООР.
static func mind_penalty() -> int:
	var lost := 1.0 - clampf(float(G.p.mind) / maxf(1.0, G.max_mind()), 0.0, 1.0)
	return -2 * clampi(floori(lost * 4.0), 0, 3)


static func bucket(total: int) -> int:
	if total <= 3: return 0
	if total <= 8: return 1
	if total <= 12: return 2
	if total <= 17: return 3
	return 4


## Голос, который прозвучит в начале разговора с who, или пустой словарь.
static func pick_voice(who: String) -> Dictionary:
	if int(G.p.flags.get("v_" + who, 0)) == int(G.p.day):
		return {}
	var pool: Array = []
	for tr in traits():
		if VOICES.has(tr):
			pool.append(tr)
	if pool.is_empty():
		return {}
	G.p.flags["v_" + who] = int(G.p.day)
	if randf() > voice_chance():
		return {}
	var tr: String = pool.pick_random()
	return {"trait": tr, "line": gender((VOICES[tr].lines as Array).pick_random(), who)}


## Действия черт, доступные сейчас с этим собеседником (каждое раз в день).
static func acts_for(who: String) -> Array:
	var res: Array = []
	for tr in traits():
		if not ACTS.has(tr):
			continue
		if int(G.p.flags.get("a_%s_%s" % [tr, who], 0)) == int(G.p.day):
			continue
		var a: Dictionary = ACTS[tr]
		if G.p.su < int(a.get("need_su", 0)):
			continue
		res.append(tr)
	return res


## Бросок исхода и его последствия. Возвращает текст для сцены.
static func resolve(kind: String, tr: String, who: String) -> String:
	var mod := 0
	var truth := false
	if kind == "voice":
		var v: Dictionary = VOICES[tr]
		mod = int(v.get("mod", 0))
		truth = v.get("truth", false)
		if has("Интуит") and tr != "Интуит":
			mod += 2
	else:
		var a: Dictionary = ACTS[tr]
		mod = int(a.get("mod", 0))
		if tr == "Рыжие волосы" and who == "ryzhaya":
			mod += 3
		kind = a.kind
		G.p.flags["a_%s_%s" % [tr, who]] = int(G.p.day)
	var d := randi_range(1, 20)
	var total := d + mod + mind_penalty()
	var b := bucket(total)
	var roll_txt := ""
	if truth:
		b = 3
		roll_txt = "[%s · всегда правдив · исход: %s]" % [tr, BUCKET_NAMES[b]]
	else:
		roll_txt = "[%s · исход к20=%d %+d = %d · %s]" % [tr, d, mod + mind_penalty(), total, BUCKET_NAMES[b]]
	var o: Array = OUTCOMES[kind][b]
	var rel: int = o[1]
	if rel > 0 and VOICES.get(tr, {}).get("double", false):
		rel *= 2
	var su: int = o[2]
	if su < 0:
		su = -mini(-su, G.p.su)
	var lines: Array = [o[0]]
	var fx: Array = []
	if rel != 0 and who != "" and preload("res://scripts/story.gd").WHO.get(who, {}).get("rel", false):
		G.rel_add(who, rel)
		fx.append("Отношение %+d" % rel)
	if su != 0:
		G.p.su += su
		fx.append("%+d Су" % su)
	if o[3] != 0:
		G.p.hp = maxi(1, G.p.hp + o[3])
		fx.append("%+d ООЗ" % o[3])
	if o[4] != 0:
		G.p.mind = clampi(G.p.mind + o[4], 1, G.max_mind())
		fx.append("%+d ООР" % o[4])
	G.changed.emit()
	var col := Pal.hex(Pal.G5) if b >= 3 else (Pal.hex(Pal.R3) if b <= 1 else Pal.hex(Pal.G3))
	var s := "[color=%s]%s[/color]\n%s" % [col, roll_txt, lines[0]]
	if fx.size() > 0:
		s += "\n[color=%s](%s)[/color]" % [col, ", ".join(fx)]
	return s
