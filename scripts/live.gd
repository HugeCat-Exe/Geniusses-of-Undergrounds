	["{Его} голос доходит с опозданием, как эхо в шахте.",
		"Тени в углу стоят не так, как должны стоять тени.",
		"Вы забыли, о чём хотели спросить. Потом вспомнили. Потом снова забыли."],
	["{Его} лицо на секунду плывёт, как мокрая краска.",
		"Пол чуть-чуть дышит. Совсем чуть-чуть.",
		"Вы слышите свой голос со стороны, и он Вам не нравится."],
	["У {него} слишком много зубов. Вы пересчитали.",
		"Стены шепчут Ваш позывной и смеются.",
		"Вы уверены, что уже видели этот разговор. Он закончился плохо."],
	["Вы не помните, как сюда попали.",
		"{Он} говорит, но слова сыплются на пол, как гайки.",
		"Где-то внутри открывается дверь, и за ней темно."],
]


static func mind_step() -> int:
	var st := 0
	var f := float(G.p.mind) / maxf(1.0, G.max_mind())
	for v in MIND_STEPS:
		if f <= v:
			st += 1
	return st


static func mind_line(who: String) -> String:
	var st := mind_step()
	if st == 0:
		return ""
	return gender((MIND_LINES[st - 1] as Array).pick_random(), who)


