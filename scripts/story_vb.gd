# ---------- условия ----------

## Самый нижний этаж, который рыцари ещё не отбили (1..10). После задания – 10.
static func frontier() -> int:
	for f in range(1, 11):
		if not G.flag("vb_f%d" % f):
			return f
	return 10


## Можно ли доехать на лифте до этажа f.
static func reachable(f: int) -> bool:
	if G.p.quests.get("vb", "") == "done":
		return f <= 10
	if f > frontier():
		return false
	if f >= 6:
		return G.flag("vb_deep")
	return true


static func cond(c: String) -> bool:
	if c.begins_with("floor"):
		var f := int(c.substr(5))
		return reachable(f) and G.p.map != "star%d" % f
	if c.begins_with("follows_"):
		var w = G.main().world
		return w != null and w.get("star") != null and w.star.is_following(c.substr(8))
	match c:
		"offer":
			return int(G.p.get("level", 1)) >= 5 and not G.p.quests.has("vb")
		"sew":
			return int(G.p.flags.get("vb_sew_%d" % int(G.p.day), 0)) < 5
		"gen2":
			return G.flag("vb_gen1") and not G.flag("vb_gen2")
		"gen3":
			return G.flag("vb_gen2") and not G.flag("vb_gen3")
		"at_gate5":
			return G.p.map == "star5" and G.flag("vb_f5") and not G.flag("vb_deep")
	return false


## Текст-подстановки для узлов квеста.
static func subst(s: String) -> String:
	if "{vb_gen}" in s:
		var done := 0
		for k in 3:
			if G.flag("vb_gen%d" % (k + 1)):
				done += 1
		var marks := ""
		for k in 3:
			var nm: String = ["Провода", "Давление в котле", "Предохранители"][k]
			marks += "%s %s\n" % ["[color=#7ff07a]■[/color]" if G.flag("vb_gen%d" % (k + 1)) else "[color=#24702f]□[/color]", nm]
		s = s.replace("{vb_gen}", "Узлы запущены: %d из 3.\n%s" % [done, marks])
	if "{vb_gunline}" in s:
		var gl := ""
		if G.flag("vb_shot"):
			gl = "– Израсходован. Значит, было во что. Хорошо."
		else:
			gl = "– Не стрелял{pa}? Значит, там было пусто. Или ты знаешь больше, чем говоришь. Неважно."
		if G.flag("vb_freed"):
			gl += "\n\nТаурос косится на тёмный коридор за спиной.\n\n" + S("Бастион Таурос", "– Что-то выползло. Мы его остановили.")
		s = s.replace("{vb_gunline}", gl)
	if "{vb_lift}" in s:
		s = s.replace("{vb_lift}", "Рыцари держат этаж %d." % frontier() if G.p.quests.get("vb", "") == "active" else "Все этажи открыты, кроме одиннадцатого.")
	return s


# ---------- эффекты ----------

static func fx(f: Array, dlg) -> void:
	match str(f[1]):
		"start":
			G.quest("vb", "active")
			G.say("Новое задание: «Венок из ветвей барбариса».")
			_ride(dlg, "south")
		"ride":
			_ride(dlg, str(f[2]))
		"fail":
			G.quest("vb", "failed")
			G.say("Задание провалено: «Венок из ветвей барбариса». История «Южной Звезды» пошла другим путём.")
			preload("res://scripts/ach.gd").unlock("vb_left")
			G.remove_item("Импульсная пушка")
			_ride(dlg, "north")
		"goto":
			var m: String = f[2]
			var sp: String = f[3]
			dlg.after.append(func(): G.main().show_world(m, sp))
		"gun":
			if not G.flag("vb_gun_given"):
				G.set_flag("vb_gun_given")
				G.add_item("Импульсная пушка")
		"shoot":
			G.set_flag("vb_shot")
			G.set_flag("vb_f11")
			preload("res://scripts/ach.gd").unlock("vb_wither")
			G.world_dirty = true
		"free":
			G.set_flag("vb_freed")
			G.set_flag("vb_f11")
			preload("res://scripts/ach.gd").unlock("vb_wither")
			G.world_dirty = true
		"join":
			G.set_flag("vb_join")
			G.set_flag("vb_f11")
			preload("res://scripts/ach.gd").unlock("vb_berries")
			G.world_dirty = true
		"button":
			G.set_flag("vb_button")
			G.set_flag("vb_f10")
			preload("res://scripts/ach.gd").unlock("vb_chips")
			G.world_dirty = true
		"return":
			G.set_flag("vb_gun_back")
			G.remove_item("Импульсная пушка")
		"farewell":
			G.set_flag("vb_farewell")
			G.p.flags["vb_done_day"] = int(G.p.day)
			G.quest("vb", "done")
			G.p.su += 500
			G.add_xp(400)
			preload("res://scripts/ach.gd").unlock("vb_done")
			G.remove_item("Импульсная пушка")
			G.say("Задание выполнено: «Венок из ветвей барбариса». Подземка «Южная Звезда» возвращается к жизни.")
			G.changed.emit()
		"sew":
			var k := "vb_sew_%d" % int(G.p.day)
			G.p.flags[k] = int(G.p.flags.get(k, 0)) + 1
			dlg.after.append(func(): G.main().open_minigame("sutura"))
		"gen":
			var gid: String = f[2]
			dlg.after.append(func(): G.main().open_minigame(gid))
		"follow":
			var w = G.main().world
			if w != null and w.get("star") != null:
				w.star.follow(str(f[2]))
		"rnd_text":
			var lines: Array = f[3]
			var t: String = lines.pick_random()
			if f.size() > 4 and f[4]:
				t = B(t)
			dlg.nodes[str(f[2])].text = t


static func _ride(dlg, dir: String) -> void:
	G.p.flags["vb_ride"] = dir
	G.p.map_at = "star" if dir == "south" else "caldera"
	dlg.after.append(func(): G.main().show_map())


## Строки трекера задания (по сценарию, раздел 15, плюс счётчики этажа).
static func tracker() -> Array:
	var st: String = G.p.quests.get("vb", "")
	if st != "active":
		return []
	var t := "Венок из ветвей барбариса – "
	var res := ""
	if not G.flag("vb_arrived"):
		res = "доехать с Артиром до «Южной Звезды»"
	elif not G.flag("vb_nikki"):
		res = "пройти проверку у баррикады"
	elif not G.flag("vb_tauros"):
		res = "поговорить с рыцарями у ворот"
	elif G.flag("vb_f11") or G.flag("vb_button"):
		res = "вернуться к рыцарям" if not G.flag("vb_gun_back") and not G.flag("vb_button") else "вернуться к рыцарям на пятый этаж"
	elif not G.flag("vb_f4"):
		res = "зачистить этажи 1–4"
	elif not G.flag("vb_f5"):
		res = "запустить генератор на Электростанции"
	elif not G.flag("vb_deep"):
		res = "спуститься ниже вместе с рыцарями"
	else:
		res = "разобраться, что происходит на нижних этажах"
	var out := [t + res]
	var line := floor_line()
	if line != "":
		out.append(line)
	return out


## Задача этажа, на котором стоит Гений (или ближайшего неотбитого).
static func floor_line() -> String:
	var f := frontier()
	var here: String = str(G.p.map)
	if here.begins_with("star") and here != "star_camp":
		var hf := int(here.substr(4))
		if hf >= 1 and hf <= 10 and G.flag("vb_f%d" % hf) and hf == f - 1 and not G.flag("vb_e%d" % f):
			return "%s зачищен%s. Спуститься на этаж %d." % [FLOOR_NAMES[hf], "а" if hf == 2 or hf == 5 else "", f]
	if not G.flag("vb_tauros") or G.flag("vb_f11") or G.flag("vb_button"):
		return ""
	if f >= 6 and not G.flag("vb_deep"):
		return ""
	var k := func(e: String) -> int: return int(G.p.flags.get("vb_k%d_%s" % [f, e], 0))
	match f:
		1: return "Вестибюль: убить Пещерных собак (%d/5)" % mini(5, k.call("pes_cave"))
		2: return "Ярмарочная площадь: убить Пещерных собак (%d/4), вывести жителей к лифту (%d/3)" % [mini(4, k.call("pes_cave")), saved()]
		3: return "Жилой этаж 1: убить Пещерных собак (%d/9)" % mini(9, k.call("pes_cave"))
		4: return "Жилой этаж 2: удержать позицию (волна %d/3)" % mini(3, int(G.p.flags.get("vb_wave", 0)))
		5: return "Электростанция: запустить генератор"
		6: return "Жилой этаж 3: убить Пещерных собак (%d/3) и Пустобрёхов (%d/2)" % [mini(3, k.call("pes_cave")), mini(2, k.call("pustobreh"))]
		7: return "Жилой этаж 4: убить Пещерных собак (%d/4) и Пустобрёхов (%d/3)" % [mini(4, k.call("pes_cave")), mini(3, k.call("pustobreh"))]
		8: return "Рабочий цех: убить Муэдзина Пещерных собак"
		9: return "Техобслуживание: спуститься ниже"
	return ""


static func saved() -> int:
	var n := 0
	for id in ["pimm", "vella", "kort"]:
		if G.flag("vb_s_" + id):
			n += 1
	return n
