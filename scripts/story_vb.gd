extends RefCounted
## Квест «Венок из ветвей барбариса»: Артир, лагерь «Перрон», рыцари Стальной Акколады,
## этажи «Южной Звезды», Барбарис. Тексты – из сценария Михаила (коды vb_*).
## Условия "vb:..." и эффекты ["vb", ...] разбираются здесь же (cond, fx).

## Реплика Барбарис: дрожащие буквы и другой шрифт.
static func B(t: String) -> String:
	return "[font=res://fonts/DejaVuSansMono-Bold.ttf][shake rate=14.0 level=7 connected=1][color=#ff6650]%s[/color][/shake][/font]" % t


## Кто говорит в авторском тексте с несколькими голосами.
static func S(who: String, t: String) -> String:
	return "[color=#7ff07a]%s:[/color] %s" % [who, t]


