extends RefCounted
## Сердца близких персонажей (у кого ★). Пять сердец открываются после «Близких знакомых».
## Сюжеты сердец пишет Михаил. Пока сердце пустое ({}), игра показывает «сюжет ещё не написан».
##
## Каждое сердце — сцена, которая сама запускается, когда Гений входит в нужную локацию:
##   "map": где происходит (caldera1…caldera4, caldera_ryhome, waste, poi_forest, raid1…)
##   "title": короткое название для пейджера
##   "where": подсказка игроку, куда идти («бар "Клык"», «логово псов»)
##   "scene": шаги катсцены (команды описаны в начале scripts/cutscene.gd)
##
## Пример (не используется в игре):
##   {"map": "caldera3", "title": "Старый жетон", "where": "бар «Клык»",
##    "scene": [
##        ["cam", 19, 4],
##        ["walk", "genius", 18, 5],
##        ["face", "ryzhaya", "left"],
##        ["say", "ryzhaya", "— А, это ты. Садись. Хочу кое-что показать."],
##        ["emote", "ryzhaya", "♥"],
##        ["say", "", "Она кладёт на стойку жетон метро."],
##        ["rel", "ryzhaya", 5],
##        ["cam"]]}

## Минимум дней между сердцами.
const GAP_DAYS := 3

const HEARTS := {
	"ryzhaya": [{}, {}, {}, {}, {}],
	"patrol": [{}, {}, {}, {}, {}],
}
