extends RefCounted
## Обложки книг из библиотеки Кальдеры: рисунки Михаила, приведены к 3:4 (180×240) и палитре в 40 цветов, PNG в base64.

const PNG := {
	"botany": "",
	"vsp": "",
	"int": "",
	"lvk": "",
	"zoo": "",
	"sefiry": "",
	"tel": "",
	"udch": "",
	"har": "",
}

static var _cache := {}


static func texture(id: String) -> Texture2D:
	if not _cache.has(id):
		var img := Image.new()
		img.load_png_from_buffer(Marshalls.base64_to_raw(PNG[id]))
		_cache[id] = ImageTexture.create_from_image(img)
	return _cache[id]
