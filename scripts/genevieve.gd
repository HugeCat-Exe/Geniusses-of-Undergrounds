extends RefCounted
## Женевьева из Института по Этике: портрет для главного меню.
## Пикселизованная фотография Михаила (112×112, палитра терминала), PNG в base64.

const PNG := ""


static func texture() -> Texture2D:
	var img := Image.new()
	img.load_png_from_buffer(Marshalls.base64_to_raw(PNG))
	return ImageTexture.create_from_image(img)
